# Cloudflare Pages response headers. Ignored by GitHub Pages, which cannot send
# custom headers at all — that limitation is the main reason for the move.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # LAUNCH: delete the next line when the site goes public. Until then this is
  # the real directive — a header outranks the <meta> tag and, unlike the tag,
  # applies to every file, not just the HTML.
  X-Robots-Tag: noindex, nofollow

# HTML must always revalidate, or a content change can sit stale behind a CDN
# edge and a browser cache at the same time.
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# CSS and JS carry a content hash in the query (tools/stamp-assets.py), so a
# changed file is always a new URL and these can never go stale.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# Video and images keep stable filenames across re-encodes, so they get a day
# rather than a year. Long enough to matter, short enough that a re-render
# reaches people the next day without a purge.
/assets/video/*
  Cache-Control: public, max-age=86400
/assets/img/*
  Cache-Control: public, max-age=86400
